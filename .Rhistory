betau = par[[2]]
alphaw = par[[3]]
betaw = par[[4]]
betai = par[[5]]
c = par[[6]]
if(any(c(alphau,betau,alphaw,betaw) < 0, na.rm = TRUE)) {
return(-2500)
}
par1 = c(betai, c)
u = sum(n, na.rm = TRUE) / sum(e, na.rm = TRUE)
w = sum(x, na.rm = TRUE) / sum(exp(betai * z), na.rm = TRUE)
p1 = ll_x(par1, w, x, z) + l_pn(e, u, n)
out = sum(p1, na.rm = TRUE) + lw(w, c(alphaw, betaw)) + lu(u,c(alphau, betau))
if (is.finite(out)) {
return(out)
} else {
return(-2500)
}
}
l_pn = function(e, u, n) {
lambda = e * u
sum(n * log(lambda) - lambda - log(factorial(n)), na.rm = TRUE)
}
lw = function(w, par) {
alpha = par[[1]]
beta = par[[2]]
p1 = alpha * log(beta) - gamma(alpha) + (alpha - 1) * log(w)
p1 - beta * w
}
lu = function(u, par) {
alpha = par[[1]]
beta = par[[2]]
p1 = alpha * log(beta) - gamma(alpha) + (alpha - 1) * log(u)
p1 - beta * u
}
ll_x_gamma = function(par, w, x, z) {
betai = par[[1]]
phi = par[[2]]
mu = w * exp(betai * z)
p = -log(gamma(phi^(-1))) - (phi^(-1)) * log(phi * mu) + (phi^(-1)) - x / (phi * mu)
sum(p, na.rm = TRUE)
}
ll_x_pareto = function(par, w, x, z) {
if (phi <= 0) {
return(-1e12)
}
betai = par[[1]]
phi = par[[2]]
mu = w * exp(betai * z)
p1 = (1 + phi^(-1)) * log(mu) + log(1 + phi)
p2 = (2 + phi^(-1)) * log(mu + phi * x)
sum(p1 - p2, na.rm = TRUE)
}
ll_x_weibull = function(par, w, x, z) {
betai = par[[1]]
gamma = par[[2]]
mu = w * exp(betai * z)
p = gamma * (log(x) - log(mu)) + gamma - (x / mu)^gamma - log(x)
sum(p, na.rm = TRUE)
}
log_prior_normal = function(par, par0, sigmas) {
p1 = log(dnorm(par[[1]], mean = par0[[1]], sd = sigmas[[7]]))
p2 = log(dnorm(par[[2]], mean = par0[[2]], sd = sigmas[[8]]))
p3 = log(dnorm(par[[3]], mean = par0[[3]], sd = sigmas[[9]]))
p4 = log(dnorm(par[[4]], mean = par0[[4]], sd = sigmas[[10]]))
p5 = log(dnorm(par[[5]], mean = par0[[5]], sd = sigmas[[11]]))
p6 = log(dnorm(par[[6]], mean = par0[[6]], sd = sigmas[[12]]))
p1 + p2 + p3 + p4 + p5 + p6
}
log_proposal_ind = function(par, par0, park, sigmas) {
p1 = log(dnorm(par[[1]], mean = par0[[1]], sd = sigmas[[1]]))
p2 = log(dnorm(par[[2]], mean = par0[[2]], sd = sigmas[[2]]))
p3 = log(dnorm(par[[3]], mean = par0[[2]], sd = sigmas[[3]]))
p4 = log(dnorm(par[[4]], mean = par0[[2]], sd = sigmas[[4]]))
p5 = log(dnorm(par[[5]], mean = par0[[2]], sd = sigmas[[5]]))
p6 = log(dnorm(par[[6]], mean = par0[[2]], sd = sigmas[[6]]))
p1 + p2 + p3 + p4 + p5 + p6
}
log_proposal_rw = function(par, par0, park, sigmas) {
1
}
sampler_ind = function(par, par0, sigmas) {
p1 = rnorm(1, mean = par0[[1]], sd = sigmas[[1]])
p2 = rnorm(1, mean = par0[[2]], sd = sigmas[[2]])
p3 = rnorm(1, mean = par0[[3]], sd = sigmas[[3]])
p4 = rnorm(1, mean = par0[[4]], sd = sigmas[[4]])
p5 = rnorm(1, mean = par0[[5]], sd = sigmas[[5]])
p6 = rnorm(1, mean = par0[[6]], sd = sigmas[[6]])
c(p1, p2, p3, p4, p5, p6)
}
sampler_rw = function(par, par0, sigmas) {
p1 = par[[1]] + rnorm(1, mean = 0, sd = sigmas[[1]])
p2 = par[[2]] + rnorm(1, mean = 0, sd = sigmas[[2]])
p3 = par[[3]] + rnorm(1, mean = 0, sd = sigmas[[3]])
p4 = par[[4]] + rnorm(1, mean = 0, sd = sigmas[[4]])
p5 = par[[5]] + rnorm(1, mean = 0, sd = sigmas[[5]])
p6 = par[[6]] + rnorm(1, mean = 0, sd = sigmas[[6]])
c(p1, p2, p3, p4, p5, p6)
}
pareto_ll2 = function(par) {
ll(datx_weibull, datn, par, ll_x_pareto, l_pn, lw, lu)
}
gamma_ll2 = function(par) {
ll(datx_weibull, datn, par, ll_x_gamma, l_pn, lw, lu)
}
weibull_ll2 = function(par) {
ll(datx_weibull, datn, par, ll_x_weibull, l_pn, lw, lu)
}
pareto_imh_sigmas_opt = optimize_mh(par0 = par0, likelihood = pareto_ll2,
sigmas0 = rep(1,12), prior = log_prior_normal,
sampler = sampler_ind, sample_dens = log_proposal_ind,
prior_optim = F, log = TRUE)
par0 = c(1,2,1,2,1e-3,2)
pareto_imh_sigmas_opt = optimize_mh(par0 = par0, likelihood = pareto_ll2,
sigmas0 = rep(1,12), prior = log_prior_normal,
