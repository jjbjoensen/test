log_likelhood = function(data, par) {
x = data
m = par[[1]]
s = par[[2]]
term = - 1 / 2 * (log(2)+log(pi)) - log(s) - 1 / (2 * s^2) * (x - m)^2
sum(term)
}
prior = function(par0, park, sigmas) {
m0 = par0[[1]]
mk = park[[1]]
s0 = par0[[2]]
sk = park[[2]]
log(dnorm(mk, m0, sigmas[[1]])) + log(dnorm(sk, s0, sigmas[[2]]))
}
sampler1 = function(par0, par, sigmas) {
m0 = par0[[1]]
s0 = par0[[2]]
muk = rnorm(1, m0, sigmas[[1]])
sk = rnorm(1, s0, sigmas[[2]])
c(muk, sk)
}
sampler2 = function(par0, par, sigmas) {
m = par[[1]]
s = par[[2]]
muk = rnorm(1, m, sigmas[[1]])
sk = rnorm(1, s, sigmas[[2]])
c(muk, sk)
}
sample_dens1 = function(par, par0, park, sigmas) {
m = par[[1]]
m0 = par0[[1]]
s = par[[2]]
s0 = par0[[2]]
log(dnorm(m, m0, sigmas[[1]])) + log(dnorm(s, s0, sigmas[[2]]))
}
sample_dens2 = function(par, par0, park, sigmas) {
m = par[[1]]
mk = park[[1]]
s = par[[2]]
sk = park[[2]]
log(dnorm(mk, m, sigmas[[1]])) + log(dnorm(sk, s, sigmas[[2]]))
}
mu = 1
s = 2
n = 1e5
td = rnorm(n, mu, s)
ll = function(par) {
log_likelhood(td, par)
}
a = metropolis_hastings(m, par0, rep(1e-3,2), ll, prior, sampler1, sample_dens1)
m = 1e3
par0 = c(2,2)
a = metropolis_hastings(m, par0, rep(1e-3,2), ll, prior, sampler1, sample_dens1)
b = metropolis_hastings(m, par0, rep(1e-3,2), ll, prior, sampler1, sample_dens1, log = T)
plot(a)
