# New:
n_policies = 5000
exposure = floor(runif(n_policies, 1, 365)) / 365
insured_val = rgamma(n_policies, 10, 10)
U = rgamma(n_policies, 1.2, 2)
n_claims = rpois(n_policies, exposure * U)
id = seq(1,n_policies)
policies = as.data.frame(cbind(id,exposure,insured_val,n_claims))
log_prior_flat = function(par, par0, sigmas) {
0
}
sim_weibull = function (n, alpha, gamma)
{
samples = numeric(n)
u = runif(n)
for (i in seq_len(n)) {
samples[[i]] = (-log(u[[i]]))^(1/gamma) * alpha
}
samples
}
m = sum(policies$n_claims)
claims_pareto = numeric(m)
claims_gamma = numeric(m)
claims_weibull = numeric(m)
claims_insured = numeric(m)
claims_id = numeric(m)
beta = 0.25
phi = 4
W = rgamma(m, 0.72, 1.91)
alpha_pareto = 1/4 + 1
alpha_gamma = 1/phi
mu_1 = exp(beta * insured_val)
i = 1
while (i < (m + 1)) {
for (j in seq_len(n_policies)) {
nn = n_claims[[j]]
if (nn == 0) {
next
} else {
for (k in seq_len(nn)) {
mu = W[[i]] * mu_1[[j]]
beta_pareto = mu / phi
beta_gamma = (phi * mu)^(-1)
claims_id[[i]] = id[[j]]
claims_insured[[i]] = policies$insured_val[[j]]
claims_pareto[[i]] = rpareto(1, alpha_pareto, beta_pareto)
claims_gamma[[i]] = rgamma(1, alpha_gamma, beta_gamma)
claims_weibull = rweibull_G(1, mu, phi)
i = i + 1
}
}
}
}
claimsize_pareto = as.data.frame(cbind(claims_id, claims_insured, claims_pareto))
claimsize_gamma = as.data.frame(cbind(claims_id, claims_insured, claims_gamma))
claimsize_weibull = as.data.frame(cbind(claims_id, claims_insured, claims_weibull))
df_x_pareto = as.data.frame(cbind(claimsize_pareto$claims_pareto, claimsize_pareto$claims_insured))
df_x_gamma = as.data.frame(cbind(claimsize_pareto$claims_pareto, claimsize_pareto$claims_insured))
df_x_weibull = as.data.frame(cbind(claimsize_pareto$claims_pareto, claimsize_pareto$claims_insured))
df_n = as.data.frame(cbind(policies$n_claims, policies$exposure))
par0 = c(1,2,1,2,1e-3,2)
datx_pareto = as.matrix(df_x_pareto)
# par: c(alpha_u,beta_u,alpha_w,beta_w,betai,phi/sigma/...)
# datax: x and z, resp.
# datan: n and exposure
# par: alphau, betau, alphaw, betaw, betai, c
ll = function(datax, datan, par, ll_x, l_pn, lw, lu) {
x = datax[, 1]
z = datax[, 2]
n = datan[, 1]
e = datan[, 2]
alphau = par[[1]]
betau = par[[2]]
alphaw = par[[3]]
betaw = par[[4]]
betai = par[[5]]
c = par[[6]]
if(any(c(alphau,betau,alphaw,betaw) < 0, na.rm = TRUE)) {
return(-2500)
}
par1 = c(betai, c)
u = sum(n, na.rm = TRUE) / sum(e, na.rm = TRUE)
w = sum(x, na.rm = TRUE) / sum(exp(betai * z), na.rm = TRUE)
p1 = ll_x(par1, w, x, z) + l_pn(e, u, n)
out = sum(p1, na.rm = TRUE) + lw(w, c(alphaw, betaw)) + lu(u,c(alphau, betau))
if (is.finite(out)) {
return(out)
} else {
return(-2500)
}
}
